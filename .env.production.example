# Copy into your deployment provider's secret manager. Never commit real values.
NODE_ENV=production
PORT=3000
VALHALLA_EXECUTION_MODE=paper

# Configure as a server-side secret. Empty means owner-only operations are disabled.
LEADER_EMAIL=

# Model provider credentials; configure only the provider you intend to use.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase project settings. Keep the service role key backend-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PUBLIC_ORIGIN=https://valhalla-app.xyz
# BullMQ task bus is disabled until a server-to-server bearer token (32+ characters)
# and TLS Redis URL are configured. Never expose the token to browser code.
VALHALLA_QUEUE_ENABLED=true
VALHALLA_DISPATCH_TOKEN=
REDIS_URL=
# Base URL of the deployed valhalla-elizaos service; /api/valhalla/* is proxied there.
ELIZA_URL=

# Optional Upstash REST credentials for server-side queues/rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Explicit production safety switches; no executor or social-posting implementation is enabled.
VALHALLA_TRADING_ENABLED=false
VALHALLA_SOCIAL_ENABLED=false
VALHALLA_KEY_STORAGE_ENABLED=false
ZEUS_IDLE_ENABLED=false
