{
  "framework": null,
  "buildCommand": "bash website/scripts/vercel-build.sh",
  "outputDirectory": "site-build",
  "proxy": {
    "entrypoint": "website/proxy.js",
    "matcher": ["/", "/index.html"]
  },
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": false },
    { "source": "/app/", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/", "destination": "/api/admin" }
  ],
  "crons": [
    { "path": "/api/overseer", "schedule": "15 12 * * *" }
  ]
}
