[Unit]
Description=Valhalla host observation beacon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/eliza-valhalla
ExecStart=%h/.bun/bin/bun run scripts/alwaysOnBeacon.ts
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
